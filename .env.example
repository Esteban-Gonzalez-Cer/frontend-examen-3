# Base URL of OUR FastAPI backend (never the SII API).
# Local: the backend runs on another port.
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Production (Vercel): use the same-origin path. vercel.json proxies /api/* to Render, so the
# HttpOnly refresh cookie is first-party (Safari/Chrome block third-party cookies).
# VITE_API_BASE_URL=/api/v1
